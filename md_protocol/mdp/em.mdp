; Energy Minimization MDP file
; For isoflavonoid-enzyme binding validation

integrator  = steep         ; steepest descent minimization
emtol       = 1000.0        ; Stop when max force < 1000.0 kJ/mol/nm
emstep      = 0.01          ; Minimization step size
nsteps      = 50000         ; Maximum number of steps

; Output control
nstlog      = 500           ; Log output frequency
nstenergy   = 500           ; Energy output frequency

; Neighbor searching
cutoff-scheme   = Verlet
ns_type         = grid
nstlist         = 10
rcoulomb        = 1.0
rvdw            = 1.0

; Electrostatics
coulombtype     = PME
pme_order       = 4
fourierspacing  = 0.16

; Constraints
constraints     = none
