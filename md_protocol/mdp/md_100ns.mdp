; Production MD - 100 ns
; For isoflavonoid-enzyme binding free energy calculation

integrator  = md
nsteps      = 50000000      ; 100 ns (2 fs * 50M)
dt          = 0.002

; Output control (save every 10 ps for analysis)
nstxout-compressed  = 5000   ; Compressed trajectory every 10 ps
nstenergy           = 5000   ; Energies every 10 ps
nstlog              = 5000   ; Log every 10 ps

; Bond parameters
continuation    = yes
constraint_algorithm = lincs
constraints     = h-bonds
lincs_iter      = 1
lincs_order     = 4

; Neighbor searching
cutoff-scheme   = Verlet
ns_type         = grid
nstlist         = 20
rcoulomb        = 1.0
rvdw            = 1.0
DispCorr        = EnerPres   ; Long-range dispersion correction

; Electrostatics
coulombtype     = PME
pme_order       = 4
fourierspacing  = 0.16

; Temperature coupling
tcoupl          = V-rescale
tc-grps         = Protein Non-Protein
tau_t           = 0.1     0.1
ref_t           = 300     300

; Pressure coupling
pcoupl          = Parrinello-Rahman
pcoupltype      = isotropic
tau_p           = 2.0
ref_p           = 1.0
compressibility = 4.5e-5

; PBC
pbc             = xyz

; Velocity generation
gen_vel         = no
